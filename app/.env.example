# PostgreSQL connection string (e.g. Supabase, local Postgres, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/busmanager?schema=public"

# Peach Payments credentials (fill in once you have a merchant account)
PEACH_ENTITY_ID=""
PEACH_ACCESS_TOKEN=""
PEACH_BASE_URL="https://eu-test.oppwa.com"

# Which PaymentProvider implementation to use. Lets you swap providers
# later without touching core order/payment logic.
PAYMENT_PROVIDER="peach"


TICKET_HASH_SECRET=<long random string>

node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
